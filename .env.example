# ==========================================
# DevFlow local / deployment environment
# Copy to .env for local Docker usage.
# Never commit the real .env file.
# ==========================================

POSTGRES_DB=devflow
POSTGRES_USER=devflow
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=1300

KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_PORT=8081
KEYCLOAK_DB_SCHEMA=keycloak

# Spring Boot API
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:1300/devflow
SPRING_DATASOURCE_USERNAME=devflow
SPRING_DATASOURCE_PASSWORD=change-me

# Keycloak resource server
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/devflow
DEVFLOW_KEYCLOAK_SERVER_URL=http://localhost:8081
DEVFLOW_KEYCLOAK_REALM=devflow
DEVFLOW_KEYCLOAK_ADMIN_CLIENT_ID=devflow-provisioner
DEVFLOW_KEYCLOAK_ADMIN_CLIENT_SECRET=change-me

# Optional application settings
SCALAR_ENABLED=true
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_DEVFLOW=INFO
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_FORMAT_SQL=false
